# Copy to mcp/.env.production on the server. Not in git: it names the site.
#
# Where the Kernix API answers. The MCP server never touches the database —
# only this public API, with each caller's own token.
KERNIX_BASE_URL=https://ibmclients.com/backend

# Serve HTTP rather than stdio, and take the token from each request so one
# deployment serves every workspace.
KERNIX_MCP_HTTP=1
KERNIX_MCP_HOSTED=1

# Loopback only. Apache is the only thing that should reach this port; the
# public route in is the .htaccess proxy on mcp.ibmclients.com.
KERNIX_MCP_HOST=127.0.0.1
KERNIX_MCP_PORT=31380

# Printed on the workspace settings screen for people to copy.
KERNIX_MCP_PUBLIC_URL=https://mcp.ibmclients.com/mcp

# Where a browser reaches Kernix — not the API address above, which ends in
# /backend. Connectors that sign in rather than carrying a token send the
# person to KERNIX_APP_URL/assistant/authorize to approve.
KERNIX_APP_URL=https://ibmclients.com

# Seals that sign-in flow. Generate once, on the server, and never change it:
#
#   echo "KERNIX_MCP_OAUTH_SECRET=$(openssl rand -hex 32)" >> .env.production
#
# It is not given a value here on purpose. A secret published in an example
# file is not a secret, and a connector that has already registered stops
# working the moment this changes. Leave it unset and sign-in stays off —
# clients that accept a pasted token are unaffected.

# A ceiling, not a grant — each person's own Kernix permissions still apply.
KERNIX_ALLOW_WRITES=1
