# Copy to .env and fill in, or set these in your MCP client's config block.
# Never commit a filled-in copy — the token is a live credential.

# Where the Kernix API lives. Local Docker default is 8000; this repo's local
# compose currently publishes the backend on 8001.
KERNIX_BASE_URL=http://localhost:8001

# Sanctum personal access token carrying the `web-api` ability. Mint one with:
#   docker compose exec backend php artisan tinker --execute="echo App\Models\User::where('username','admin')->firstOrFail()->createToken('MCP', ['web-api'])->plainTextToken;"
KERNIX_API_TOKEN=

# Read-only unless this is set. When off, the write tools are not registered at
# all, so an assistant cannot call them by mistake.
KERNIX_ALLOW_WRITES=0

# Kernix refuses task changes unless the acting account is clocked in. With this
# set, task writes carry `admin_override` — honoured only for administrators.
# Leave off and use kernix_clock_in if you want the attendance record to be true.
KERNIX_ADMIN_OVERRIDE=0

# HTTP transport (for remote clients). Omit to serve on stdio.
KERNIX_MCP_HTTP=0
KERNIX_MCP_HOST=127.0.0.1
KERNIX_MCP_PORT=8765

KERNIX_TIMEOUT_SECONDS=30
