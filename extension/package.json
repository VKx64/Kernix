{
  "name": "kernix-companion",
  "private": true,
  "version": "1.0.0",
  "description": "Manifest V3 time and task companion for Kernix.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VKx64/Kernix.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/VKx64/Kernix/issues"
  },
  "homepage": "https://github.com/VKx64/Kernix",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "npm run icons",
    "build": "npm run typecheck && vite build && node scripts/validate-build.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/chrome": "0.2.2",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "8.0.16",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
