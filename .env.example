# Kernix local configuration. Copy this file to `.env`, choose private admin
# credentials, and keep `.env` untracked. Historical project/database identifiers are intentionally
# retained to preserve existing Docker volumes and local data.
# Keep this project name distinct from `production-management`, which belongs to
# the preserved legacy PHP stack and its Docker volumes.
COMPOSE_PROJECT_NAME=production-management-v2

FRONTEND_PORT=5173
BACKEND_PORT=8000
MYSQL_PORT=3307

APP_NAME=Kernix
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
LOG_LEVEL=debug
SESSION_LIFETIME=480

# Optional. When blank, Docker generates a private key once and reuses it from
# the backend storage volume so sessions survive container rebuilds.
APP_KEY=

# Compatibility identifiers: changing these requires a database migration and
# may make the existing named volume appear empty.
DB_NAME=production_v2
DB_USER=production_v2_user
DB_PASSWORD=production_v2_local_password
DB_ROOT_PASSWORD=production_v2_root_password

# Cookie authentication is normally same-origin through the frontend proxy.
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required only for the first database seed and never committed. Use at least
# 12 characters; changing it later does not reset an existing admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Required only when starting the archived legacy Compose stack. On first
# start it replaces the historical published admin password without resetting
# an admin password that was already changed.
LEGACY_ADMIN_PASSWORD=
