# Kernix local configuration. Copy this file to `.env`, choose private admin
# credentials, and keep `.env` untracked. Historical project/database identifiers are intentionally
# retained to preserve existing Docker volumes and local data.
# Keep this project name distinct from `production-management`, which belongs to
# the preserved legacy PHP stack and its Docker volumes.
COMPOSE_PROJECT_NAME=production-management-v2

FRONTEND_PORT=5173
BACKEND_PORT=8000
MYSQL_PORT=3307

APP_NAME=Kernix
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
LOG_LEVEL=debug
SESSION_LIFETIME=480

# Optional. When blank, Docker generates a private key once and reuses it from
# the backend storage volume so sessions survive container rebuilds.
APP_KEY=

# Compatibility identifiers: changing these requires a database migration and
# may make the existing named volume appear empty.
DB_NAME=production_v2
DB_USER=production_v2_user
DB_PASSWORD=production_v2_local_password
DB_ROOT_PASSWORD=production_v2_root_password

# Cookie authentication is normally same-origin through the frontend proxy.
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the MCP server answers, printed on the workspace settings screen so a
# person can copy a working endpoint. Leave blank locally; in production this is
# the public HTTPS address, e.g. https://mcp.ibmclients.com/mcp
MCP_PUBLIC_URL=
MCP_PORT=8765
# The MCP deployment's ceiling on writing. Kernix still applies each token
# holder's own permissions on top of this.
MCP_ALLOW_WRITES=1
MCP_ADMIN_OVERRIDE=0

# The WhatsApp bridge. The token is a shared secret between the Laravel side and
# the bridge container, in both directions — it is the bridge's only proof of
# identity when it posts an inbound message, so change it from the default and
# treat it like a password. The URL is the Compose service; leave it alone unless
# the bridge runs somewhere else.
#
# Note what this is: an unofficial WhatsApp client holding a real account's
# session. WhatsApp can ban a number it decides is automated. Use a number you
# can afford to lose.
WHATSAPP_BRIDGE_URL=http://whatsapp:8790
WHATSAPP_BRIDGE_TOKEN=kernix-local-whatsapp-bridge-secret
# Name shown in WhatsApp's "linked devices" list on the phone.
WHATSAPP_DEVICE_NAME=Kernix
# What the assistant answers to in a group chat. It stays silent in a group until
# somebody addresses it by this word.
WHATSAPP_TRIGGER=kernix
# Fills in a locally-written number, so `09171234567` matches `639171234567`.
WHATSAPP_COUNTRY_CODE=63
# Who tasks raised from a chat are authored by. Blank means the project's own
# manager, which is usually what you want.
WHATSAPP_ACTOR_USER_ID=
WHATSAPP_LOG_LEVEL=warn

# Required only for the first database seed and never committed. Use at least
# 12 characters; changing it later does not reset an existing admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Required only when starting the archived legacy Compose stack. On first
# start it replaces the historical published admin password without resetting
# an admin password that was already changed.
LEGACY_ADMIN_PASSWORD=
